# Sélectionne l'agence servie par ce build/déploiement.
# Valeurs disponibles : voir les clés exportées dans config/brands/index.ts
# (actuellement : nlprestige, swisslocrent, swisselite, bullrent, eagledrive, elegancyrent, slgrent, luxurydrive,
# luxurcars, garagecarlos, lamarbrerie, topcarsoccasions, distefano, easyloc).
# luxurcars utilise le gabarit "showroom" (voir components/showroom/), garagecarlos/lamarbrerie le gabarit "garage",
# topcarsoccasions le gabarit "dealer", distefano le gabarit "electricien", easyloc et les autres agences de location le gabarit "classic".
# Chaque projet Vercel pointe vers ce même dépôt et définit sa propre valeur
# dans Project Settings > Environment Variables.
# Aucune valeur ici n'est un secret : ce fichier peut rester commité tel quel.
NEXT_PUBLIC_BRAND=nlprestige
